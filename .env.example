# Lia environment configuration.
#
# Copy to .env.local and fill in. .env* is gitignored — never commit real values.
#
# With none of these set, Lia runs on the deterministic demo dataset and the
# shell shows a "Demo data" badge. That is the intended local default.

# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
# Setting both of these switches the app onto the database. Both are safe to
# expose to the browser: the anon key only grants what row-level security allows.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY. Bypasses row-level security entirely.
# Required for the Google integration: OAuth handshakes and encrypted
# credentials live in tables with RLS enabled and zero policies, which only the
# service role can reach. Also used for migrations and seeding.
# Never prefix with NEXT_PUBLIC_, never import into a client component.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# Public origin of this deployment, no trailing slash. Used to build absolute
# URLs. Defaults to http://localhost:3000.
APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Credential encryption
# ---------------------------------------------------------------------------
# SERVER ONLY. Encrypts OAuth access and refresh tokens before they are stored,
# using AES-256-GCM. The key lives here rather than in the database on purpose:
# a database dump on its own then decrypts nothing.
#
# 32 bytes, base64 / base64url / hex. Generate one with:
#   openssl rand -base64 32
#
# Losing this key loses no data, but every connection must then be
# reauthorized — the stored tokens become unreadable.
TOKEN_ENCRYPTION_KEY=

# Names the active key so ciphertext stays readable across a rotation. Existing
# values record the key that sealed them. Leave unset to use "default".
TOKEN_ENCRYPTION_KEY_ID=

# ---------------------------------------------------------------------------
# Google Business Profile
# ---------------------------------------------------------------------------
# SERVER ONLY. From a Google Cloud project with the Business Profile APIs
# enabled. See docs/integrations/google-business-profile.md for the full setup,
# including the API enablement and quota request Google requires.
#
# GOOGLE_CLIENT_SECRET must never be exposed through a NEXT_PUBLIC_ prefix.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Must match a redirect URI registered on the OAuth client EXACTLY — Google
# compares the whole string, including scheme, port, and path.
# Lia takes this from configuration and never from a request parameter.
#
#   Local:      http://localhost:3000/api/integrations/google-business-profile/callback
#   Preview:    https://<deployment-host>/api/integrations/google-business-profile/callback
#   Production: https://<your-domain>/api/integrations/google-business-profile/callback
#
# Google permits http://localhost for development but requires https elsewhere,
# so a production callback over http is rejected at consent time.
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/integrations/google-business-profile/callback

# "live" or "mock". Leave unset to decide from the credentials above.
#
# "mock" serves a deterministic fixture connector so the whole flow — consent
# redirect, callback, state validation, discovery, mapping, disconnect — can be
# walked without a Google Cloud project. It is REFUSED when NODE_ENV=production:
# a deployment quietly serving fabricated Google accounts would be worse than
# one that fails loudly. Still requires TOKEN_ENCRYPTION_KEY, because mock mode
# runs the real storage path.
GOOGLE_INTEGRATION_MODE=

# ---------------------------------------------------------------------------
# Overrides
# ---------------------------------------------------------------------------
# Pin the data adapter regardless of the Supabase values above.
# "demo" | "supabase". Leave unset to decide from the credentials.
LIA_DATA_SOURCE=
