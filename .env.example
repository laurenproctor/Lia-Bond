# Lia — environment template
#
# Copy to `.env.local` and fill in. Never commit a filled-in copy: `.gitignore`
# ignores `.env*` and un-ignores only this file.
#
# Shape is validated at startup, presence at first use — so the app builds and
# runs with none of the integration values set. Each feature fails with a
# configuration error naming exactly what is missing, at the moment somebody
# tries to use it.

# ---------------------------------------------------------------------------
# Database
#
# Setting the two NEXT_PUBLIC values switches the app off demo data and onto
# Supabase. Leave them unset to run entirely on the in-memory seed.
# ---------------------------------------------------------------------------

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Bypasses row-level security entirely.
#
# Required by two things: the Google integration, whose OAuth state and
# encrypted credentials live in tables with RLS enabled and zero policies; and
# `npm run auth:seed`, which creates the seeded logins through the admin API.
#
# Never prefix with NEXT_PUBLIC_, never import into a client component.
SUPABASE_SERVICE_ROLE_KEY=

# `demo` or `supabase`. Pins the adapter; otherwise the credentials decide.
LIA_DATA_SOURCE=

# Public origin of this deployment. Defaults to http://localhost:3000.
APP_URL=

# ---------------------------------------------------------------------------
# Credential encryption
#
# Required whenever a real OAuth flow runs — and in mock mode too, because the
# mock stores its fake tokens through the same vault. Running the real
# encryption path in development is what catches a broken vault before
# production does.
# ---------------------------------------------------------------------------

# 32 bytes, base64 / base64url / hex.  Generate: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# Names the active key so ciphertext stays readable across a rotation.
TOKEN_ENCRYPTION_KEY_ID=

# ---------------------------------------------------------------------------
# Google Business Profile
#
# Full setup, including the Cloud Console steps and the scope rationale:
# docs/integrations/google-business-profile.md
# ---------------------------------------------------------------------------

# Server only. Never NEXT_PUBLIC_.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Must match a redirect URI registered on the OAuth client exactly — scheme,
# host, port, and path. Read from configuration, never from a request
# parameter: this is the value an open-redirect attack wants control of.
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/integrations/google-business-profile/callback

# `live` or `mock`. Unset decides from whether the OAuth client is configured.
#
# `mock` walks the entire flow — state validation, code exchange, encrypted
# storage, discovery, mapping, review import, disconnect — without a Google
# Cloud project. Refused at environment parse when NODE_ENV=production: a
# deployment quietly serving fabricated Google accounts would be worse than one
# that failed to boot.
GOOGLE_INTEGRATION_MODE=

# ---------------------------------------------------------------------------
# Mention analysis
#
# Classifies imported mentions for relevance, sentiment, topics, and risk, and
# raises an escalation when it finds something serious. Full detail:
# docs/ai/analysis.md
# ---------------------------------------------------------------------------

# Server only. Never NEXT_PUBLIC_, never imported into a client component.
ANTHROPIC_API_KEY=

# `live` or `mock`. Unset decides from whether the key is present.
#
# `mock` is a deterministic fixture that reacts to the text, so the escalation
# path is reachable locally without a key. Refused in production for a sharper
# reason than the Google mock: a fabricated "low risk" on a food-safety
# complaint is not a cosmetic problem.
LIA_AI_MODE=

# Mentions analysed per run. Defaults to 50.
#
# Bounded so one click has a predictable cost. A run that hits the cap records
# what it left behind rather than reporting a triaged inbox that is not.
LIA_ANALYSIS_BATCH_SIZE=

# ---------------------------------------------------------------------------
# News monitoring
#
# Polls a news provider for articles matching each organization's monitoring
# queries, filters them through a deterministic relevance gate, and ingests
# what survives as mentions. Full detail:
# docs/superpowers/specs/2026-08-04-news-monitoring-design.md
# ---------------------------------------------------------------------------

# Server only. A GNews API key.
#
# Note the provider: the connector implemented today is GNews, not
# newsapi.ai / Event Registry. D71 records Event Registry as the intended
# upgrade, and a key for it will not authenticate against this client — the
# request shape and the response schema are both different.
GNEWS_API_KEY=

# `live` or `mock`. Unlike Google and the analyser, unset means unconfigured
# rather than live: `live` must be set explicitly *and* a key must be present.
#
# `mock` returns a deterministic article set so the gate, the ingest, and the
# poll history are reachable with no provider account. Refused in production,
# for the same reason as the other two mocks: a deployment quietly serving
# fabricated news coverage is worse than one that says news is not configured.
LIA_NEWS_MODE=

# ---------------------------------------------------------------------------
# Yelp Assisted
#
# Connects a Yelp listing to a location, checks its review count and star
# rating on a schedule, and tells somebody when either moves. It does NOT read
# Yelp reviews and does NOT post replies — both are Yelp Partner API
# capabilities Lia does not hold. Full detail, including the upgrade path:
# docs/integrations/yelp-assisted.md
# ---------------------------------------------------------------------------

# Server only. Never NEXT_PUBLIC_, never imported into a client component.
#
# A Yelp Fusion API key from https://www.yelp.com/developers/v3/manage_app.
# There is no client secret and no OAuth handshake: the key authenticates
# *Lia*, not the customer, and proves nothing about who owns a listing.
#
# Travels in an Authorization header rather than a query parameter, so it does
# not end up in request logs and error messages the way a URL token does.
YELP_API_KEY=

# `live` or `mock`. Unset means unconfigured — the news rule, not the Google
# one: `live` must be set explicitly *and* a key must be present.
#
# A key alone does not imply live, because a Yelp key belongs to a plan and the
# plan decides which endpoints answer. An operator can hold a valid key whose
# plan does not cover business matching at all.
#
# `mock` serves a deterministic listing whose counters can be scripted, so the
# connect flow, activity detection, capture, and the assisted-posting handoff
# are all reachable with no Yelp account. Refused in production, and the reason
# is sharper than for the other mocks: the mock's whole output is two numbers,
# and two fabricated numbers on a real listing produce a "review activity
# detected" notice with nothing on screen to give the lie away.
LIA_YELP_MODE=

# Listing checks one scheduled sweep may make. Defaults to 50.
#
# Yelp meters per API key and the key is shared by every tenant, so this is a
# Lia-level budget enforced above the tenant loop — one organization with forty
# listings must not exhaust the day for everyone else. The remaining headroom
# is what the interactive connect flow spends.
YELP_MAX_CHECKS_PER_SWEEP=

# ---------------------------------------------------------------------------
# Reddit monitoring
#
# Coverage, stated once so no copy anywhere overstates it: Lia searches
# matching Reddit posts and monitors comments in those threads; it does not
# search every Reddit comment. Reddit's search endpoint covers posts, not the
# global comment corpus.
#
# Reddit is the one integration here where holding a credential and being
# allowed to use it are separate facts. Commercial API access is granted by a
# negotiated agreement, so these variables come in two halves: the OAuth client
# (below) and the record of what Reddit permitted
# (REDDIT_ROLLOUT_STAGE / REDDIT_ACCESS_APPROVAL_REF / REDDIT_AI_INFERENCE).
# Both halves must be present before anything reaches Reddit's servers —
# see docs/integrations/reddit-access-approval.md.
# ---------------------------------------------------------------------------

# Server only. From a **web app** registered at
# https://www.reddit.com/prefs/apps — not `script`, not `installed app`.
#
# Lia reads and posts, and posting is only possible in a user context: the
# client-credentials grant authenticates as the application and cannot write.
# So this is the Google credential model rather than the GNews one — an
# authorization-code handshake per organization, a refresh token sealed in the
# vault, and replies that appear under whichever Reddit account that
# organization connected. Request `duration=permanent` on the authorize URL or
# Reddit returns no refresh token and every connection dies after an hour.
#
# Access is not self-service. Reddit requires prior approval before an OAuth
# client works, and commercial use — which this is — requires a signed
# contract. Register nothing and expect nothing to authenticate until that is
# done: docs/integrations/reddit.md.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Must match the redirect URI registered on the Reddit app exactly.
#
#   Local:      http://localhost:3000/api/integrations/reddit/callback
#   Production: https://lia.bond/api/integrations/reddit/callback
#
# Reddit's registration form takes one redirect URI, where Google's takes a
# list — so local and production need two separate Reddit apps, each with its
# own id and secret, rather than two URIs on one app.
#
# Register the apex only. `www.lia.bond` is redirected to it by
# next.config.ts, and a redirect landing mid-callback would arrive on a host
# the session cookie does not cover.
REDDIT_OAUTH_REDIRECT_URI=http://localhost:3000/api/integrations/reddit/callback

# Required, and not a formality — Reddit throttles generic, shared, or absent
# user agents far harder than identified ones, and asks for this exact shape:
#
#   <platform>:<app id>:<version> (by /u/<reddit username>)
#
# For example: web:bond.lia.monitor:0.1.0 (by /u/your-reddit-username)
#
# Validated against that shape at startup. A malformed agent does not fail, it
# degrades — and it degrades into a 429 in production rather than into
# something anybody notices locally.
REDDIT_USER_AGENT=

# `live` or `mock`. The news rule rather than the Google one: unset means
# unconfigured, so `live` must be set explicitly *and* the whole client — id,
# secret, redirect URI, user agent — must be present.
#
# `mock` serves a deterministic thread fixture so the gate, the ingest, and the
# approval path are reachable with no Reddit app — and records a posted reply
# without posting it, which is the only safe way to exercise a write path
# against a live public forum. Refused in production like every other mock
# here: fabricated public discussion about a restaurant is worse than an honest
# "Reddit is not configured".
LIA_REDDIT_MODE=

# `off`, `read_only`, or `read_write`. Unset means `off`.
#
# Separate from the mode because "the connector works" and "we are permitted to
# use it" are different questions for Reddit in a way they are not for Google
# or GNews. `off` calls nothing; `read_only` discovers, refreshes, and
# analyses; only `read_write` can ever reach Reddit's comment endpoint, and
# only then behind a named human approval.
#
# Follows RULES_EXECUTION_MODE rather than the mode enums: this decides whether
# Lia touches a live public forum, so absence of configuration means absence of
# the behaviour. An unmet prerequisite drops the deployment all the way to
# `off`, never part-way to `read_only` — the agreement governs reading as much
# as posting, so a half-measure would keep making the calls Reddit has not
# agreed to and stop only the ones it has.
REDDIT_ROLLOUT_STAGE=

# Comma-separated organization ids permitted to use Reddit while this rolls
# out. Unset means empty: no organization is admitted by default.
REDDIT_ORG_ALLOWLIST=

# The Gate 0 marker, shaped `YYYY-MM-DD:<reference>`.
#
# Records that Reddit granted commercial access, and when. Without it a `live`
# deployment resolves to `off` no matter how complete the OAuth client is —
# which is the point: Reddit's is the one integration where a valid credential
# does not imply a right to use it.
#
# Dated rather than a bare boolean so it cannot be satisfied by typing
# "approved", and so the retention schedule has a date to count from. Not a
# secret, and not a security boundary — it is here so that turning Reddit on is
# a deliberate act naming the agreement that permits it.
#
# Fill in docs/integrations/reddit-access-approval.md first. The value is
# derived from two rows of that table.
REDDIT_ACCESS_APPROVAL_REF=

# `permitted` or `not_permitted`. Unset means not permitted.
#
# Whether the signed terms allow running a model over Reddit content, for
# classification or for draft generation. Its own switch because the two rights
# are genuinely separable: an agreement can allow display to a customer's team
# and withhold AI inference, and Lia has to be able to ship monitoring under
# those terms without also shipping drafting.
#
# Ignored in mock mode, where the content is fabricated and no agreement can be
# breached by inferring over it.
REDDIT_AI_INFERENCE=

# ---------------------------------------------------------------------------
# Scheduled jobs
# ---------------------------------------------------------------------------

# Shared secret the scheduler presents to /api/cron/*. At least 16 characters.
#
# These are the only routes in the application authenticated by a secret
# rather than by a session or by RLS: Vercel Cron invokes them with no browser
# session, so `middleware.ts` exempts `/api/cron` from the auth gate
# (SESSIONLESS_PATHS) and each handler checks this value itself with a
# timing-safe comparison. Unset means the routes reject every request, which
# is the correct default: an unauthenticated sweep endpoint is worse than no
# sweep. Schedules live in vercel.ts.
CRON_SECRET=

# ---------------------------------------------------------------------------
# Outbound mail
# ---------------------------------------------------------------------------

# Resend API key. Unset means Lia sends nothing: the help and contact forms
# still record what they were given, and invitations still produce a copyable
# link. Nothing claims a delivery that did not happen.
RESEND_API_KEY=

# "live" or "log". Unset means live when a key is present. "log" writes each
# message to the server log and delivers nothing — it exists so the forms can be
# exercised locally without a Resend account, and it is refused outright when
# NODE_ENV=production.
LIA_EMAIL_MODE=

# Where help requests and contact messages are delivered. Defaults to
# lauren@lia.bond.
SUPPORT_INBOX_EMAIL=

# Envelope sender for help and contact mail. A bare address or "Name <address>".
# Defaults to Resend's shared identity, onboarding@resend.dev, which delivers
# only to the address that owns the Resend account.
SUPPORT_FROM_EMAIL=

# Envelope sender for invitations. Same shape, and deliberately NOT the same
# variable as SUPPORT_FROM_EMAIL (D193).
#
# It must sit on a domain verified with Resend. The support default above is the
# shared resend.dev identity, which only ever reaches the Resend account owner —
# fine for a help request addressed to us, and silent total failure for an
# invitation addressed to a restaurant manager: the provider accepts it and
# nobody receives it. So there is no fallback. Unset means Lia does not email
# invitations at all, says so on the screen, and hands the inviter a link to
# send by hand.
INVITE_FROM_EMAIL=

# ---------------------------------------------------------------------------
# Billing (Stripe)
#
# Subscription billing, the 14-day card-required trial, and purchased location
# capacity. Full setup, including the Dashboard steps that have to be repeated
# separately in sandbox and live mode: docs/billing.md and
# docs/billing-stripe-runbook.md
#
# Both values below are server-only and neither has a NEXT_PUBLIC_ counterpart.
# Checkout and the customer portal are Stripe-hosted pages Lia redirects to,
# created server-side, so there is no publishable key, no Stripe.js in the
# bundle, and no Stripe credential in the browser at all.
#
# Leave all of this unset to run the product with billing dormant: entitlement
# returns full access, the billing screens say Stripe is not configured, and
# nothing charges anybody.
# ---------------------------------------------------------------------------

# Server only. sk_test_… in development and preview, sk_live_… in production.
#
# The environment refuses both crossings at startup rather than at the till: a
# sandbox key in production is the mistake that looks like it is working
# (Checkout succeeds, webhooks arrive, no money moves), and a live key in
# development charges real cards from a branch.
STRIPE_SECRET_KEY=

# The signing secret of the webhook endpoint, from the Stripe Dashboard.
#
# Per endpoint and per mode — the sandbox and live endpoints have different
# secrets, and so does `stripe listen` when you run it locally. Every webhook
# request is verified against this before a single byte of its body is trusted;
# without it the route refuses everything, which is the correct posture for an
# unauthenticated endpoint that grants paid access.
STRIPE_WEBHOOK_SECRET=

# `live` or `mock`. Unset decides from whether the two values above are present.
#
# `mock` is a deterministic in-memory gateway: fake session URLs, fake customer
# and subscription ids, driving the same projection path a real webhook does.
# It exists so the whole lifecycle — checkout, trial, conversion, failure,
# cancellation — is reachable in CI and on a laptop with no Stripe account,
# which is what keeps a real key out of the test environment. Refused outright
# when NODE_ENV=production: a deployment quietly issuing fake subscriptions
# would hand out the product for nothing and record that it had been paid for.
LIA_BILLING_MODE=

# `off`, `allowlist`, or `on`. Unset means off.
#
# What billing state is allowed to *do*, as opposed to what Lia knows about it.
# Off means every organization keeps full access however its subscription
# looks; the projection still updates, the trial countdown still renders, and
# the payment warnings are still honest. That separation is deliberate: it lets
# the whole feature ship, be watched, and be corrected before it can lock
# anybody out.
#
# This is also the emergency kill switch. Setting it back to `off` restores
# full access to every organization immediately, without cancelling, modifying,
# or refunding a single Stripe subscription. It is for deployment safety, not
# for bypassing payment indefinitely.
BILLING_ENFORCEMENT_MODE=

# Comma-separated organization ids enforcement applies to while the mode is
# `allowlist`. The rollout step where a real payment is tested against one
# internal tenant before anybody else is affected.
#
# Required when the mode is `allowlist`: enforcing for nobody while reading as
# switched on is how a rollout gets declared finished before it began, so the
# pairing is refused at startup.
BILLING_ORG_ALLOWLIST=
