# No trailing slash, so this covers a symlinked `node_modules` as well as a real
# one. This checkout lives in iCloud Drive, which evicts the contents of files it
# thinks are cold — leaving entries that report their true size and read back as
# zero bytes, so eslint and Next fail with errors that look like version
# conflicts (`Ajv__default.default is not a constructor`) rather than like
# missing data. Pointing `node_modules` at a `.nosync` directory does not survive
# npm: both `npm ci` and `npm install` delete the path and recreate it as a real
# directory, so the symlink silently disappears on the next install.
node_modules
node_modules.nosync/
.next/
out/
build/
.DS_Store
*.pem
.env*
!.env.example
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.next-dev.log
.vercel
*.tsbuildinfo
next-env.d.ts

# Supabase CLI link state — machine-local, contains no secrets but no value in git
supabase/.temp/

# Worktrees created by the harness. Git-ignored scratch: the branch inside
# carries the work, and an unignored worktree directory is how an entire
# second checkout gets committed into the repository by a stray `git add -A`.
.claude/worktrees/

# Claude Code personal settings (permissions, local overrides)
.claude/settings.local.json
